pkgname=crest
pkgver=2.5.0
pkgrel=5
pkgdesc="Fiordland desktop shell, based on Caelestia"
arch=('x86_64')
url='https://fiordlandlinux.org'
license=('GPL-3.0-only')
depends=('caelestia-cli' 'quickshell' 'glibc' 'gcc-libs'
         'ddcutil' 'brightnessctl'
         'libcava' 'networkmanager' 'bluez' 'lm_sensors' 'aubio' 'libpipewire' 'libqalculate' 'power-profiles-daemon'
         'ttf-material-symbols-variable' 'inter-font' 'ttf-cascadia-code-nerd'
         'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-m3shapes-git'
         'swappy' 'bash')
optdepends=('fprintd: fingerprint unlock for the lock screen')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
provides=('caelestia-shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')
source=("crest-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!debug')

build() {
  cd crest
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/ \
    -DVERSION=$pkgver \
    -DGIT_REVISION=fiordland \
    -DDISTRIBUTOR="Fiordland Linux"
  cmake --build build
}

package() {
  cd crest
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
